---
import CopyCommand from '../islands/CopyCommand';
import Icon from './Icon.astro';
import { t, type Lang } from '../i18n';
import { SERVER_COMMAND } from '../lib/releases';
interface Props { lang: Lang }
const d = t(Astro.props.lang);
// Tabs carry the header's short names (the header links switch these tabs); panels keep the full titles.
const tracks = [
  { id: 'desktop', icon: 'desktop' as const, x: d.tracks.desktop, tab: d.nav.desktop },
  { id: 'server', icon: 'server' as const, x: d.tracks.server, tab: d.nav.server },
];
---

<!--
  Two tabs, so "Install on a server" (hero, header) shows the server steps alone and "Desktop" the desktop ones.
  Without JavaScript both panels are shown one under the other and the tab bar is hidden.
-->
<section data-tracks data-active="desktop" class="border-y border-slate-200/70 bg-slate-50/60 py-20 sm:py-28 dark:border-white/5 dark:bg-white/[.02]">
  <div class="mx-auto max-w-5xl px-5 sm:px-6">
    <div class="reveal text-center">
      <h2 class="text-3xl font-extrabold tracking-[-0.03em] sm:text-5xl">{d.tracks.title}</h2>
      <p class="mt-4 text-lg text-muted dark:text-night-muted">{d.tracks.lead}</p>
    </div>
    <div role="tablist" aria-label={d.tracks.title} class="tabbar reveal mx-auto mt-10 hidden w-fit gap-1 rounded-2xl border border-slate-200/80 bg-white p-1.5 shadow-sm dark:border-white/10 dark:bg-night-card">
      {tracks.map((tr) => (
        <a role="tab" href={`#${tr.id}`} id={`tab-${tr.id}`} aria-controls={tr.id} aria-selected={tr.id === 'desktop' ? 'true' : 'false'} data-tab={tr.id}
          class="inline-flex items-center gap-2 rounded-xl px-4 py-2.5 text-sm font-semibold text-muted transition hover:text-ink aria-selected:bg-brand aria-selected:text-white sm:px-5 dark:text-night-muted dark:hover:text-night-ink dark:aria-selected:bg-brand-light dark:aria-selected:text-night">
          <Icon name={tr.icon} class="size-4" />{tr.tab}
        </a>
      ))}
    </div>
    <div class="mt-8 space-y-6">
      {tracks.map((tr) => (
        <article id={tr.id} role="tabpanel" aria-labelledby={`tab-${tr.id}`} data-panel={tr.id} class="reveal scroll-mt-24 flex min-w-0 flex-col rounded-3xl border border-slate-200/80 bg-white p-7 shadow-sm sm:p-9 dark:border-white/10 dark:bg-night-card">
          <div class="flex items-center gap-3">
            <div class="grid size-12 place-items-center rounded-2xl bg-gradient-to-br from-brand to-[#8f6fd8] text-white shadow-md"><Icon name={tr.icon} class="size-6" /></div>
            <div>
              <h3 class="text-2xl font-extrabold tracking-tight">{tr.x.title}</h3>
              <p class="text-sm font-medium text-muted dark:text-night-muted">{tr.x.tag}</p>
            </div>
          </div>
          <ol class="mt-7 space-y-4">
            {tr.x.steps.map((s, n) => (
              <li class="flex gap-4">
                <span class="grid size-8 shrink-0 place-items-center rounded-full border-2 border-brand/30 text-sm font-bold text-brand dark:border-brand-light/40 dark:text-brand-light">{n + 1}</span>
                <span class="pt-1 font-medium">{s}</span>
              </li>
            ))}
          </ol>
          {tr.id === 'server' && (
            <div class="mt-6">
              <p class="mb-2 text-sm font-semibold text-muted dark:text-night-muted">{d.tracks.command}</p>
              <CopyCommand client:visible command={SERVER_COMMAND} labels={d.copy} full />
            </div>
          )}
          <p class="mt-6 text-sm text-muted dark:text-night-muted">{tr.x.note}</p>
          <p class="mt-6 flex items-start gap-3 rounded-2xl border border-brand/15 bg-brand/5 px-5 py-4 text-sm text-slate-700 dark:border-brand-light/20 dark:bg-brand-light/5 dark:text-slate-200">
            <Icon name="clock" class="mt-0.5 size-5 shrink-0 text-brand dark:text-brand-light" /><span>{d.tracks.firstRun}</span>
          </p>
          <div class="pt-7">
            {tr.id === 'server'
              ? <a href={d.links.serverDocs} target="_blank" rel="noopener" class="inline-flex items-center gap-1.5 text-sm font-semibold text-brand hover:underline dark:text-brand-light">{tr.x.cta}<Icon name="external" class="size-4" /></a>
              : <a href="#downloads" class="inline-flex items-center gap-2 rounded-xl bg-brand px-5 py-3 font-semibold text-white transition hover:bg-brand-dark dark:bg-brand-light dark:text-night dark:hover:bg-white"><Icon name="download" />{tr.x.cta}</a>}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  :global(html.js) [data-tracks] .tabbar { display: flex; }
  :global(html.js) [data-tracks][data-active='desktop'] [data-panel='server'],
  :global(html.js) [data-tracks][data-active='server'] [data-panel='desktop'] { display: none; }
</style>

<script>
  const section = document.querySelector<HTMLElement>('[data-tracks]');
  const tablist = section?.querySelector<HTMLElement>('[role="tablist"]');
  if (section && tablist) {
    const ids = ['desktop', 'server'];
    const show = (id: string) => {
      section.dataset.active = id;
      section.querySelectorAll<HTMLElement>('[data-tab]').forEach((t) => t.setAttribute('aria-selected', String(t.dataset.tab === id)));
    };
    // Put the tab bar a fixed gap under the sticky header. offsetTop is layout-only, so the reveal animation's
    // translate (still running on arrival) cannot shift where we land.
    const scrollToTabs = (smooth: boolean) => {
      let top = 0;
      for (let el: HTMLElement | null = tablist; el; el = el.offsetParent as HTMLElement | null) top += el.offsetTop;
      const header = document.querySelector<HTMLElement>('[data-header]')?.offsetHeight ?? 0;
      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
      scrollTo({ top: top - header - 24, behavior: smooth && !reduce ? 'smooth' : 'instant' });
    };
    // Links to #desktop / #server: a tab only switches (the page stays put); any other link (hero, header)
    // switches and brings the tabs into view. The address follows either way.
    document.addEventListener('click', (e) => {
      const a = (e.target as Element).closest?.('a[href^="#"]');
      const id = a?.getAttribute('href')?.slice(1);
      if (!id || !ids.includes(id)) return;
      e.preventDefault();
      show(id);
      if (location.hash !== `#${id}`) history.pushState(null, '', `#${id}`);
      if (!a!.closest('[role="tablist"]')) scrollToTabs(true);
    });
    const fromHash = () => {
      const id = location.hash.slice(1);
      if (!ids.includes(id)) return;
      show(id);
      scrollToTabs(false);
    };
    addEventListener('popstate', fromHash);
    // A typed or scripted #fragment also scrolls natively, after popstate; line up once more on the next frame.
    addEventListener('hashchange', () => requestAnimationFrame(fromHash));
    fromHash();
    // On a direct visit the browser runs its own jump to the fragment later than this script; line up again after it.
    if (document.readyState !== 'complete') addEventListener('load', () => requestAnimationFrame(fromHash), { once: true });
  }
</script>
