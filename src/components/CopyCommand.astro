---
// A shell command with a copy button. `full` stretches the box to its container (the button then sits at the right
// edge); otherwise it hugs the command. src/scripts/copy.ts does the copying and fades whichever edge hides part of
// the command instead of showing a scrollbar; the static HTML assumes the usual case, a long command cut on the right.
interface Props {
  command: string;
  labels: { copy: string; copied: string; failed: string; label: string };
  full?: boolean;
}
const { command, labels, full = false } = Astro.props;
const rightFade = 'linear-gradient(to right, #000, #000 calc(100% - 2rem), transparent)';
---

<div
  class:list={['flex items-center gap-3 rounded-xl bg-ink px-4 py-3 font-mono text-[12px] text-[#c9d8ff] shadow-lg ring-1 ring-ink/10 dark:bg-black/40 dark:ring-white/10', full ? 'w-full' : 'w-fit max-w-full']}
  data-copy-command
  data-copied={labels.copied}
  data-failed={labels.failed}
>
  <span aria-hidden="true" class="select-none text-brand-light">$</span>
  <code
    tabindex="0"
    aria-label={labels.label}
    style={`mask-image:${rightFade};-webkit-mask-image:${rightFade}`}
    data-cut="right"
    class="min-w-0 flex-1 overflow-x-auto whitespace-nowrap rounded-sm [scrollbar-width:none] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-light [&::-webkit-scrollbar]:hidden"
  >{command}</code>
  <button
    type="button"
    aria-live="polite"
    class="shrink-0 rounded-lg bg-white/10 px-3 py-1.5 font-sans text-xs font-semibold text-white transition hover:bg-white/20 focus-visible:outline-2 focus-visible:outline-brand-light"
  >{labels.copy}</button>
</div>

<script>
  import { initCopyCommands } from '../scripts/copy';
  initCopyCommands();
</script>
