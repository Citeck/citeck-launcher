---
import Icon from './Icon.astro';
import { t, type Lang } from '../i18n';
interface Props { lang: Lang }
const d = t(Astro.props.lang);
---

<section id="faq" class="scroll-mt-20 border-t border-slate-200/70 py-20 sm:py-28 dark:border-white/5">
  <div class="mx-auto max-w-3xl px-5 sm:px-6">
    <h2 class="reveal text-center text-3xl font-extrabold tracking-[-0.03em] sm:text-4xl">{d.faq.title}</h2>
    <div class="mt-10 divide-y divide-slate-200 rounded-3xl border border-slate-200/80 bg-white dark:divide-white/10 dark:border-white/10 dark:bg-night-card">
      {d.faq.items.map((f) => (
        <details class="group reveal">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-6 py-5 font-semibold focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-brand [&::-webkit-details-marker]:hidden">
            {f.q}
            <Icon name="chevron" class="size-5 shrink-0 text-muted transition-transform group-open:rotate-180 dark:text-night-muted" />
          </summary>
          <p class="px-6 pb-6 leading-relaxed text-muted dark:text-night-muted">{f.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>
