---
import Icon from './Icon.astro';
import Kicker from './Kicker.astro';
import { t, type Lang } from '../i18n';
interface Props { lang: Lang }
const d = t(Astro.props.lang);
const icons = ['contract', 'cart', 'users', 'building'] as const;
---

<section class="py-20 sm:py-28" id="citeck">
  <div class="mx-auto max-w-7xl px-5 sm:px-6">
    <div class="reveal max-w-3xl">
      <Kicker text={d.what.kicker} />
      <h2 class="mt-3 text-3xl font-extrabold tracking-[-0.03em] text-balance sm:text-5xl">{d.what.title}</h2>
      <p class="mt-5 text-lg leading-relaxed text-muted dark:text-night-muted">{d.what.lead}</p>
    </div>
    <div class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {d.what.cases.map((c, i) => (
        <div class="reveal group rounded-2xl border border-slate-300/80 bg-white p-6 transition hover:border-brand/40 hover:shadow-lg dark:border-white/10 dark:bg-night-card dark:hover:border-brand-light/40" style={`transition-delay:${i * 70}ms`}>
          <div class="grid size-11 place-items-center rounded-xl bg-brand/10 text-brand dark:bg-brand-light/15 dark:text-brand-light"><Icon name={icons[i]} /></div>
          <h3 class="mt-4 text-lg font-bold">{c.title}</h3>
          <p class="mt-1 text-sm text-muted dark:text-night-muted">{c.text}</p>
        </div>
      ))}
    </div>
    <a href={d.links.citeck} target="_blank" rel="noopener" class="reveal mt-8 inline-flex items-center gap-1.5 font-semibold text-brand hover:underline dark:text-brand-light">{d.what.more}<Icon name="arrow" class="size-4" /></a>
  </div>
</section>
