const { name, class: cls = 'size-5' } = Astro.props;
const fill = name === 'docker';
---

<svg
  class={cls}
  viewBox="0 0 24 24"
  fill={fill ? 'currentColor' : 'none'}
  stroke={fill ? 'none' : 'currentColor'}
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  set:html={PATHS[name]}
/>
