---
import DownloadButton from './DownloadButton.astro';
import CopyCommand from './CopyCommand.astro';
import Icon from './Icon.astro';
import { t, type Lang } from '../i18n';
import { SERVER_COMMAND } from '../lib/releases';
interface Props { lang: Lang }
const d = t(Astro.props.lang);
---

<section class="blob-hero relative overflow-hidden py-24 sm:py-32">
  <div class="reveal mx-auto flex max-w-5xl flex-col items-center px-5 text-center sm:px-6">
    <h2 class="text-4xl font-extrabold tracking-[-0.035em] sm:text-6xl">{d.cta.title}</h2>
    <p class="mt-4 text-lg text-muted dark:text-night-muted">{d.cta.lead}</p>
    <div class="mt-9 flex flex-col items-center [&_.flex-wrap]:justify-center">
      <DownloadButton labels={{ ...d.hero, ...d.downloads }} showMeta={false} />
    </div>
    <p class="mt-10 text-sm font-semibold text-muted dark:text-night-muted">{d.cta.server}</p>
    <div class="mt-3 flex w-full justify-center">
      <CopyCommand command={SERVER_COMMAND} labels={d.copy} />
    </div>
    <a href={d.links.serverDocs} target="_blank" rel="noopener" class="mt-3 inline-flex items-center gap-1.5 text-sm font-semibold text-brand hover:underline dark:text-brand-light">{d.tracks.server.cta}<Icon name="external" class="size-4" /></a>
  </div>
</section>
