---
import Icon from './Icon.astro';
import Kicker from './Kicker.astro';
import { t, type Lang } from '../i18n';
interface Props { lang: Lang }
const d = t(Astro.props.lang);
const [first, ...rest] = d.features.items;
const icons = ['shield', 'archive', 'lock', 'activity'] as const;
const services = ['postgres', 'rabbitmq', 'keycloak', 'emodel', 'gateway'];
---

<section class="py-20 sm:py-28">
  <div id="features" class="mx-auto max-w-7xl scroll-mt-[88px] px-5 sm:px-6">
    <div class="reveal max-w-3xl">
      <Kicker text={d.features.kicker} />
      <h2 class="mt-3 text-3xl font-extrabold tracking-[-0.03em] text-balance sm:text-5xl">{d.features.title}</h2>
    </div>
    <div class="mt-12 grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-3 lg:grid-rows-2">
      <article class="reveal relative flex min-w-0 flex-col overflow-hidden rounded-3xl border border-slate-300/80 bg-gradient-to-br from-white to-[#eef3fb] p-7 sm:p-8 md:col-span-2 lg:col-span-1 lg:row-span-2 dark:border-white/10 dark:from-night-card dark:to-[#16203a]">
        <div class="flex items-start justify-between gap-4">
          <h3 class="min-w-0 pt-1.5 text-xl font-extrabold tracking-tight hyphens-auto sm:text-2xl">{first.title}</h3>
          <div class="grid size-11 shrink-0 place-items-center rounded-xl bg-emerald-500/10 text-emerald-600 dark:text-emerald-400"><Icon name="heart" /></div>
        </div>
        <p class="mt-2 text-muted dark:text-night-muted">{first.text}</p>
        <div class="mt-8 rounded-2xl bg-[#1f2126] p-4 font-mono text-[12.5px] text-slate-300 shadow-xl ring-1 ring-black/5 lg:mt-auto" aria-hidden="true">
          <div class="mb-3 flex items-center justify-between font-sans text-xs font-semibold text-emerald-400">
            <span class="flex items-center gap-2"><span class="size-2 rounded-full bg-emerald-400"></span>{d.features.statusTitle} · {d.features.statusRunning}</span>
            <span class="text-slate-400">5/5</span>
          </div>
          <ul class="space-y-1.5">
            {services.map((s, i) => (
              <li class="flex items-center justify-between rounded-md bg-white/[.03] px-2.5 py-1.5">
                <span class="text-sky-300">{s}</span>
                {i === 3
                  ? <span class="pulse-status inline-grid justify-items-end whitespace-nowrap"><span class="st-a rounded bg-emerald-500/15 px-2 py-0.5 text-emerald-400 [grid-area:1/1]">● {d.features.statusRunning}</span><span class="st-b rounded bg-amber-500/15 px-2 py-0.5 text-amber-400 [grid-area:1/1]">● {d.features.statusRestarting}</span></span>
                  : <span class="rounded bg-emerald-500/15 px-2 py-0.5 text-emerald-400">● {d.features.statusRunning}</span>}
              </li>
            ))}
          </ul>
        </div>
      </article>
      {rest.map((f, i) => (
        <article class="reveal min-w-0 rounded-3xl border border-slate-300/80 bg-white p-7 transition hover:shadow-lg dark:border-white/10 dark:bg-night-card" style={`transition-delay:${(i + 1) * 70}ms`}>
          <div class="flex items-start justify-between gap-4">
            <h3 class="min-w-0 pt-2 text-xl font-bold tracking-tight hyphens-auto">{f.title}</h3>
            <div class="grid size-11 shrink-0 place-items-center rounded-xl bg-brand/10 text-brand dark:bg-brand-light/15 dark:text-brand-light"><Icon name={icons[i]} /></div>
          </div>
          <p class="mt-2 text-sm leading-relaxed text-muted dark:text-night-muted">{f.text}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  /* One service flips to "restarting" and back — the self-healing loop, CSS only. */
  .pulse-status .st-b { opacity: 0; animation: flip 5s ease-in-out infinite; }
  .pulse-status .st-a { animation: flip-a 5s ease-in-out infinite; }
  @keyframes flip { 0%, 55%, 100% { opacity: 0; } 62%, 85% { opacity: 1; } }
  @keyframes flip-a { 0%, 55%, 100% { opacity: 1; } 62%, 85% { opacity: 0; } }
  @media (prefers-reduced-motion: reduce) { .pulse-status .st-a, .pulse-status .st-b { animation: none; } }
</style>
