---
import ThemeToggle from './ThemeToggle.astro';
import Icon from './Icon.astro';
import logo from '../assets/citeck-logo.svg?raw';
import { t, type Lang } from '../i18n';
import { pagePath } from '../lib/lang';

interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang);
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const other: Lang = lang === 'ru' ? 'en' : 'ru';
const nav = [
  { href: '#features', label: d.nav.features },
  { href: '#desktop', label: d.nav.desktop },
  { href: '#server', label: d.nav.server },
];
---

<header id="top" class="sticky top-0 z-50 border-b border-transparent bg-white/75 backdrop-blur-lg transition-colors dark:bg-night/75" data-header>
  <div class="mx-auto flex h-16 max-w-7xl items-center gap-6 px-5 sm:px-6">
    <a href={pagePath(lang, base)} class="flex items-center gap-2.5 text-brand dark:text-brand-light" aria-label={d.nav.home}>
      <span class="block h-[22px] w-[94px] [&>svg]:h-full [&>svg]:w-full" set:html={logo} />
      <span class="rounded-md bg-brand/10 px-1.5 py-0.5 text-xs font-bold tracking-wide text-brand-dark dark:bg-brand-light/15 dark:text-brand-light">Launcher</span>
    </a>

    <nav class="ml-4 hidden items-center gap-1 text-sm font-medium lg:flex" aria-label={d.nav.main}>
      {nav.map((n) => <a href={n.href} class="rounded-lg px-3 py-2 text-muted transition hover:bg-slate-100 hover:text-ink dark:text-night-muted dark:hover:bg-white/10 dark:hover:text-night-ink">{n.label}</a>)}
      <a href={d.links.docs} class="rounded-lg px-3 py-2 text-muted transition hover:bg-slate-100 hover:text-ink dark:text-night-muted dark:hover:bg-white/10 dark:hover:text-night-ink" target="_blank" rel="noopener">{d.nav.docs}</a>
      <a href={d.links.github} class="flex items-center gap-1.5 rounded-lg px-3 py-2 text-muted transition hover:bg-slate-100 hover:text-ink dark:text-night-muted dark:hover:bg-white/10 dark:hover:text-night-ink" target="_blank" rel="noopener"><Icon name="github" class="size-4" />GitHub</a>
    </nav>

    <div class="ml-auto flex items-center gap-1.5">
      <a
        href={pagePath(other, base)}
        hreflang={other}
        lang={other}
        title={d.nav.langName}
        aria-label={d.nav.langName}
        class="grid h-9 min-w-9 place-items-center rounded-lg px-2 text-xs font-bold tracking-wider text-muted transition hover:bg-slate-100 hover:text-ink dark:text-night-muted dark:hover:bg-white/10 dark:hover:text-night-ink"
        data-lang-switch={other}
      >{d.nav.lang}</a>
      <ThemeToggle label={d.nav.theme} />
      <a href="#downloads" class="ml-1.5 hidden rounded-lg bg-brand px-4 py-2 text-sm font-semibold text-white shadow-sm transition hover:bg-brand-dark sm:inline-flex dark:bg-brand-light dark:text-night dark:hover:bg-white">{d.nav.download}</a>
      <details class="relative lg:hidden">
        <summary class="grid size-9 cursor-pointer list-none place-items-center rounded-lg text-muted hover:bg-slate-100 dark:text-night-muted dark:hover:bg-white/10 [&::-webkit-details-marker]:hidden" aria-label={d.nav.menu}>
          <Icon name="menu" />
        </summary>
        <div class="absolute right-0 top-11 w-56 rounded-2xl border border-slate-200 bg-white p-2 shadow-xl dark:border-white/10 dark:bg-night-card">
          {nav.map((n) => <a href={n.href} class="block rounded-lg px-3 py-2 text-sm font-medium hover:bg-slate-100 dark:hover:bg-white/10">{n.label}</a>)}
          <a href={d.links.docs} class="block rounded-lg px-3 py-2 text-sm font-medium hover:bg-slate-100 dark:hover:bg-white/10" target="_blank" rel="noopener">{d.nav.docs}</a>
          <a href={d.links.github} class="block rounded-lg px-3 py-2 text-sm font-medium hover:bg-slate-100 dark:hover:bg-white/10" target="_blank" rel="noopener">GitHub</a>
          <a href="#downloads" class="mt-1 block rounded-lg bg-brand px-3 py-2 text-center text-sm font-semibold text-white dark:bg-brand-light dark:text-night">{d.nav.download}</a>
        </div>
      </details>
    </div>
  </div>
</header>

<script>
  const header = document.querySelector('[data-header]');
  const onScroll = () => header?.classList.toggle('!border-slate-200/70', window.scrollY > 8);
  const onScrollDark = () => header?.classList.toggle('dark:!border-white/10', window.scrollY > 8);
  addEventListener('scroll', () => { onScroll(); onScrollDark(); }, { passive: true });
  document.querySelectorAll<HTMLAnchorElement>('[data-lang-switch]').forEach((a) =>
    a.addEventListener('click', () => {
      try { localStorage.setItem('lang', a.dataset.langSwitch!); } catch { /* private mode */ }
    }),
  );
  document.querySelectorAll('details a').forEach((a) => a.addEventListener('click', () => a.closest('details')?.removeAttribute('open')));
</script>
