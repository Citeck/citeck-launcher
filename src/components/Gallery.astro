---
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import Kicker from './Kicker.astro';
import { t, type Lang } from '../i18n';
interface Props { lang: Lang }
const d = t(Astro.props.lang);
const files = import.meta.glob<{ default: ImageMetadata }>('../assets/screenshots/*.png', { eager: true });
// Only screenshots that exist are shown, so a missing capture can never render as a broken image.
const items = d.gallery.items
  .map((i) => ({ ...i, img: files[`../assets/screenshots/${i.src}.png`]?.default }))
  .filter((i): i is typeof i & { img: ImageMetadata } => Boolean(i.img));
---

{items.length > 1 && (
  <section class="border-y border-slate-200/70 bg-slate-50/60 py-20 sm:py-28 dark:border-white/5 dark:bg-white/[.02]">
    <div class="mx-auto max-w-7xl px-5 sm:px-6">
      <div class="reveal max-w-3xl">
        <Kicker text={d.gallery.kicker} />
        <h2 class="mt-3 text-3xl font-extrabold tracking-[-0.03em] sm:text-5xl">{d.gallery.title}</h2>
      </div>
      <div tabindex="0" role="region" aria-label={d.gallery.title} class="-mx-5 mt-12 rounded-sm focus-visible:outline-2 focus-visible:outline-brand flex snap-x snap-mandatory gap-5 overflow-x-auto px-5 pb-4 sm:mx-0 sm:px-0 lg:grid lg:grid-cols-2 lg:gap-8 lg:overflow-visible">
        {items.map((it) => (
          <figure class="reveal w-[85%] shrink-0 snap-center sm:w-[70%] lg:w-auto">
            <div class="overflow-hidden rounded-2xl bg-[#1f2126] shadow-[0_30px_60px_-25px_rgb(13_27_62/.45)] ring-1 ring-slate-900/10 dark:ring-white/20">
              <Picture src={it.img} alt={it.alt} formats={['avif', 'webp']} widths={[480, 800, 1200]} sizes="(min-width: 1024px) 600px, 85vw" loading="lazy" decoding="async" class="block h-auto w-full" />
            </div>
            <figcaption class="mt-3 text-sm font-medium text-muted dark:text-night-muted">{it.caption}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>
)}
